# 노트북(GPU 없음) 로컬 실행용 설정. scripts/setup_windows.ps1 이 .env 가 없을 때 이 파일을 .env 로 복사한다.
# DB·torch 없이 bge-m3(ONNX int8, 570MB) + SQLite + 메모리 인덱스로 동작.

# [임베딩] 첫 실행 때 %USERPROFILE%\.cache\dart_rag\gpahal__bge-m3-onnx-int8\ 로 자동 다운로드
EMBED_PROVIDER=bge-m3-onnx

# [저장소] DB 설치 없이
DOCSTORE_BACKEND=sqlite
INDEX_BACKEND=memory
QDRANT_URL=

# [LLM] 하나 이상 넣으면 실제 답변 생성. 비우면 '발췌만 제공' 모드.
OPENAI_API_KEY=
GEMINI_API_KEY=

# [실데이터 수집 시] https://opendart.fss.or.kr
OPENDART_API_KEY=

# Docker(Postgres + Qdrant)로 바꾸려면:  docker compose up -d  후
# DOCSTORE_BACKEND=postgres
# DATABASE_URL=postgresql://dart:dart@localhost:5432/dart
# INDEX_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
