# cp .env.example .env  후 값 입력.  .env 는 git 에 커밋하지 마세요.

# [필수] OpenDART — https://opendart.fss.or.kr → 인증키 신청/관리
OPENDART_API_KEY=

# [LLM] GPT-6 Luna(답변·에이전트)와 OpenAI 임베딩 → OPENAI_API_KEY, auto 라우터 → GEMINI_API_KEY
#       rag 모드는 config/providers.yaml 의 order(gemini → gemini_lite → openai) 순서로 시도
GEMINI_API_KEY=
OPENAI_API_KEY=
# LLM_ORDER=gemini_lite,openai

# [저장소]
# DART_DATA_ROOT=data                      # GPU 서버: /mnt/storage/dart (2TB 영구 스토리지)

# [임베딩] openai(현재 data/ 기준) | bge-m3 | bge-m3-onnx | e5 | hashing(테스트용)
EMBED_PROVIDER=openai
# EMBED_DEVICE=auto                        # auto | cuda | cpu
# EMBED_BATCH_SIZE=

# [DocStore: 청크 본문] sqlite | postgres   (postgres 는 docker compose up -d 로 Postgres + Qdrant 실행 후)
DOCSTORE_BACKEND=sqlite
# DATABASE_URL=postgresql://dart:dart@localhost:5432/dart

# [인덱스] qdrant | memory
INDEX_BACKEND=memory
# QDRANT_URL=http://localhost:6333           # 비우면 로컬 파일 모드 (서버 불필요)
# QDRANT_API_KEY=

# [리랭커] auto | on | off
# RERANK_MODE=auto
